# Read-only connection to the KrishiDukan Firebase project, used only by
# src/features/retail-network to display the public retailer network on
# the homepage. This is a SEPARATE Firebase project from the one above —
# never used for writes, auth, or anything outside that feature module.
VITE_KRISHIDUKAN_FIREBASE_API_KEY=""
VITE_KRISHIDUKAN_FIREBASE_AUTH_DOMAIN=""
VITE_KRISHIDUKAN_FIREBASE_PROJECT_ID=""
VITE_KRISHIDUKAN_FIREBASE_STORAGE_BUCKET=""
VITE_KRISHIDUKAN_FIREBASE_MESSAGING_SENDER_ID=""
VITE_KRISHIDUKAN_FIREBASE_APP_ID=""

# Google Maps JavaScript API key for the retail network map. Reuses the
# same key as KrishiDukan's own map by default; replace with your own key
# if you want independent quota/billing.
VITE_GOOGLE_MAPS_API_KEY=""
